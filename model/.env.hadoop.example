# For a Windows-hosted notebook, use WebHDFS on the Docker host.
HDFS_ENABLED=true
HDFS_NAMENODE=webhdfs://10.38.10.84:9870
HDFS_INPUT_DIR=/datasets/multidomain
HDFS_OUTPUT_DIR=/analytics/iot-multidomain
HDFS_UPLOAD_LOCAL_DATA=true
SPARK_DISTRIBUTED=false
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=8

# The Docker host must publish NameNode WebHDFS port 9870 and DataNode ports
# 9864/9866 with a host-reachable advertised DataNode address.
